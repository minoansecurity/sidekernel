# Interactive shell rc, loaded with bash --rcfile.
# shellcheck shell=bash
set +H   # disable history expansion so a pasted '!' stays literal

export PATH=/root/.local/bin:/run/sidekernel/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LANG=C.UTF-8 TERM="${TERM:-xterm-256color}"

__sk_ps1() {
    local code=$? net=
    read -r net < "${SK_ROOT:-}/run/sk-net.state" 2>/dev/null
    if [ -n "${NO_COLOR:-}" ] || [ "$TERM" = dumb ]; then
        PS1="\n  [sandbox] ${SIDEKERNEL_PROJECT:+${SIDEKERNEL_PROJECT} }[net ${net:-?}] \w\n  > "
    else
        local R='\[\e[0m\]'
        local chip='\[\e[1;38;2;16;24;26;48;2;0;190;218m\]'
        local seafoam='\[\e[38;2;72;209;176m\]'
        local mist='\[\e[38;2;120;120;130m\]'
        local netseg="${mist}● net ?${R}"
        [ "$net" = on ] && netseg='\[\e[38;2;72;209;120m\]● net on'"$R"
        [ "$net" = off ] && netseg='\[\e[38;2;230;80;80m\]● net off'"$R"
        local arrow="$seafoam"
        [ "$code" -ne 0 ] && arrow='\[\e[38;2;224;108;117m\]'
        PS1="\n  ${chip} ◆ sandbox ${R} ${seafoam}${SIDEKERNEL_PROJECT:-}${R} ${netseg} ${mist}\w${R}\n  ${arrow}▸${R} "
    fi
}
PROMPT_COMMAND=__sk_ps1

# sk-drop takes a host path, which no guest completion could know.
complete -W 'status on off' sk-net
complete -W '' sk-drop save ramblinwreck fightsong

# --rcfile replaces ~/.bashrc, so source it back.
# shellcheck disable=SC1091
[ -f /root/.bashrc ] && . /root/.bashrc
